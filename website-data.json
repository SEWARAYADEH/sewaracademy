  "visionMission": {
    "vision": {
      "ar": "أن نكون المنصة الرائدة في التعليم التقني والتطوير البرمجي في الوطن العربي، ونساهم في بناء جيل من المبرمجين والمطورين القادرين على المنافسة عالمياً",
      "en": "To be the leading platform in technical education and software development in the Arab world, contributing to building a generation of programmers and developers capable of competing globally"
    },
    "mission": {
      "ar": "تقديم تعليم تقني عالي الجودة ومعتمد دولياً، مع التركيز على التطبيق العملي والمشاريع الحقيقية، لتمكين المتدربين من دخول سوق العمل بثقة وكفاءة",
      "en": "Providing high-quality, internationally accredited technical education, focusing on practical application and real projects, to empower trainees to enter the job market with confidence and competence"
    }
  },
